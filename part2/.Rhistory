CMs <- list()
models <- list()
out <- NULL
for(k in 1:7){
#split training and testing data based on fold ID
df_test <- df[folds==k,]
df_train <- df[folds!=k,]
#train the model
model_SVM <- svm(Condition~., data=df_train, kernel = 'linear')
#store model in the list
models[[k]] <- model_SVM
#predict using LDA
pred <- predict(model_SVM, newdata=df_test)
#create confusion matrix
CM = confusionMatrix(data=as.factor(pred), as.factor(df_test$Condition))
fold_spec <- CM$byClass[["Specificity"]]
fold_sens <- CM$byClass[["Sensitivity"]]
fold_metrics <- c(CM$overall, Sensitivity = fold_sens, Specificity = fold_spec)
#store the confusion matrix and metrics
CMs[[k]] <- CM
out <- rbind(out, fold_metrics)
}
cv_results <- as.data.frame(out)
svm_linear_summary_stats <- colMeans(cv_results)
print(svm_linear_summary_stats)
