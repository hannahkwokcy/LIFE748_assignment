library(dplyr)
library(readr)
library(Biostrings)
# --- CRITICAL FIX: Hardcode your exact cluster path here ---
# Example: setwd("/home/hlckwok2/research/your_assembly_folder/")
# Create an empty list to store results
all_results <- list()
# Run the following loop for both assembly types
# Use c() instead of list() for string iteration
samples <- c('flye', 'spades')
for (s in samples) {
cat("\n==================================\n")
cat("Processing Assembly:", s, "\n")
cat("==================================\n")
# Create paths for bakta and prokka
p_path <- paste0("prokka_", s, ".tsv")
b_path <- paste0("bakta_", s, ".tsv")
f_path <- paste0("bakta_", s, ".fna")
# SAFETY TRIPWIRE: Stop the script immediately if the file is missing
if (!file.exists(p_path)) stop(paste("CRITICAL ERROR: R cannot find", p_path, "in", getwd()))
if (!file.exists(b_path)) stop(paste("CRITICAL ERROR: R cannot find", b_path, "in", getwd()))
if (!file.exists(f_path)) stop(paste("CRITICAL ERROR: R cannot find", f_path, "in", getwd()))
# --- Prokka Extraction ---
cat("Reading", p_path, "...\n")
p_data <- read.table(p_path, sep = "\t", header = TRUE, comment.char = "#", fill = TRUE, quote = "")
colnames(p_data) <- tolower(colnames(p_data))
p_n_cds  <- sum(p_data$ftype == "CDS", na.rm = TRUE)
p_n_trna <- sum(p_data$ftype == "tRNA", na.rm = TRUE)
p_n_rrna <- sum(p_data$ftype == "rRNA", na.rm = TRUE)
p_func   <- sum(!is.na(p_data$product) & !grepl("hypothetical", p_data$product))
p_func_pct <- p_func / p_n_cds
p_hypo <- p_n_cds - p_func
# --- Bakta Extraction ---
cat("Reading", b_path, "...\n")
b_data <- read.delim(b_path, sep = "\t", header = TRUE, comment.char = "#", quote = "", fill = TRUE, check.names = FALSE)
colnames(b_data) <- c("sequence_id", "type", "start", "stop", "strand", "locus_tag", "gene", "product")
b_n_cds  <- sum(b_data$type == "cds", na.rm = TRUE)
b_n_trna <- sum(b_data$type == "tRNA", na.rm = TRUE)
b_n_rrna <- sum(b_data$type == "rRNA", na.rm = TRUE)
b_cds_only <- b_data[b_data$type == "cds", ]
b_func <- sum(!is.na(b_cds_only$product) & !grepl("hypothetical", b_cds_only$product, ignore.case = TRUE))
b_func_pct <- b_func / b_n_cds
b_hypo  <- b_n_cds - b_func
# --- GC Content Extraction ---
cat("Reading", f_path, "...\n")
fa <- readDNAStringSet(f_path)
total_bp <- sum(width(fa))
gc_fraction <- sum(letterFrequency(fa, c("G", "C"))) / total_bp
# Store all results into the list
all_results[[s]] <- tibble(
sample          = s,
genome_size     = total_bp,
gc_content      = gc_fraction,
prokka_CDS      = p_n_cds,
bakta_CDS       = b_n_cds,
prokka_tRNA     = p_n_trna,
bakta_tRNA      = b_n_trna,
prokka_rRNA     = p_n_rrna,
bakta_rRNA      = b_n_rrna,
prokka_func     = p_func,
prokka_hypo     = p_hypo,
bakta_func      = b_func,
bakta_hypo      = b_hypo,
prokka_func_pct = p_func_pct,
bakta_func_pct  = b_func_pct
)
}
